# ============================================
# JARVIS Configuration — Copy to .env and fill in
# ============================================

# OpenAI API Key (required)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model selection: "gpt-4o-mini" (cheap/fast) or "gpt-4o" (flagship)
JARVIS_MODEL=gpt-4o-mini

# Server settings
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your Telegram User ID (for auth — only you can use the bot)
# Send /start to @userinfobot on Telegram to get your ID
TELEGRAM_ALLOWED_USER_ID=your-numeric-user-id

# Memory settings
SHORT_TERM_MEMORY_SIZE=15
CHROMA_DB_PATH=./server/data/chroma_db
PROFILE_PATH=./server/data/stark_profile.json
WORKSPACE_PATH=./server/data/jarvis_workspace
CONVERSATION_LOG_PATH=./server/data/conversation_logs

# Safety: Max tokens per request (prevents runaway costs)
MAX_RESPONSE_TOKENS=2048
